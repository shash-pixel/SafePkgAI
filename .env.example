# PackageMind AI runtime configuration
APP_NAME=PackageMind AI
ENVIRONMENT=development
DATABASE_PATH=packagemind.db
REQUEST_TIMEOUT_SECONDS=15

# Add a real value only in your untracked local .env file.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_SUMMARY_MAX_OUTPUT_TOKENS=900

LOG_LEVEL=INFO
